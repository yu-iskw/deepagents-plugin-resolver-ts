{
  "name": "@deepagents-plugins/core",
  "version": "0.1.0",
  "description": "Stable facade over the Deep Agents plugin resolve, compile, and load pipeline.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
